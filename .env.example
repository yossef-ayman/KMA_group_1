# ========================================================
# KMA Wedding & Media Production — Environment Template
# ========================================================
# Duplicate this file as .env and fill in real production values.
# NEVER commit real credentials or secrets to version control.

# Application Environment (production / development)
NODE_ENV=production

# Server Port (Hostinger / Node default)
PORT=5000

# Database Configuration: MySQL (Primary Production Database for Hostinger)
# Compatible with Hostinger MySQL / cPanel phpMyAdmin / VPS / CloudLinux
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u123456789_kma_user
DB_PASSWORD=your_secure_db_password
DB_NAME=u123456789_kma_db

# Alternative Single URL format for MySQL:
# MYSQL_URL=mysql://u123456789_kma_user:your_secure_db_password@127.0.0.1:3306/u123456789_kma_db

# Legacy Database (MongoDB Atlas) - Optional / Fallback if MySQL is unconfigured
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/kma_production?retryWrites=true&w=majority
MONGODB_URI=

# Master Admin Passcode (Plaintext fallback for migration)
ADMIN_PASSCODE=

# Bcrypt Hash of Master Admin Passcode (Recommended for production)
# Generate with: node -e "require('bcryptjs').hash('your-passcode', 10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Cryptographic Secret for Signing HTTP-only Admin Session Cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Allowed CORS Origin(s) (comma-separated if multiple)
# In production, set to your live domain (e.g. https://kmawedding.com)
CORS_ORIGIN=

# Frontend API Base URL
# Leave blank when frontend and backend are served from the same domain (e.g. /api)
# Set to full URL if the frontend is hosted on a separate origin or CDN.
VITE_API_URL=

# Hostinger FTP Deployment Configuration (Used by: npm run deploy)
FTP_HOST=217.65.157.157
FTP_PORT=21
FTP_USER=u460510257
FTP_PASSWORD=your_ftp_password_here
FTP_REMOTE_DIR=public_html

